<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. The downloaded archive (files/atdt/) can be
     fetched again, so it is neither backed up nor copied to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="atdt/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="atdt/" />
    </device-transfer>
</data-extraction-rules>
